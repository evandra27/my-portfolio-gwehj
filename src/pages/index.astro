---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/home/Hero.astro';
import TrustedStrip from '~/components/home/TrustedStrip.astro';
import Collaborate from '~/components/home/Collaborate.astro';
import StatsBand from '~/components/home/StatsBand.astro';
import About from '~/components/home/About.astro';
import Services from '~/components/home/Services.astro';
import Toolkit from '~/components/home/Toolkit.astro';
import Work from '~/components/home/Work.astro';
import Process from '~/components/home/Process.astro';
import Awards from '~/components/home/Awards.astro';
import Testimonials from '~/components/home/Testimonials.astro';
import Journal from '~/components/home/Journal.astro';
import Faq from '~/components/home/Faq.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, websiteSchema } from '~/lib/jsonld';

const jsonLd = graph([personSchema(siteConfig), websiteSchema(siteConfig)]);
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  appendSiteName={false}
  jsonLd={jsonLd}
>
<Hero />
<Work />        <!-- 1. Projek naik ke paling atas agar langsung terlihat -->
<About />       <!-- 2. Pengalaman kampus, organisasi, & latar belakang -->
<Awards />  
<Services />    <!-- 3. Sertifikat & pencapaian lomba -->    <!-- 4. Tech stack, tools, & skills -->
<!-- <Process />     5. Alur kerja / metodologi (opsional) -->

<!-- Section tambahan di bawah ini bisa di-comment jika belum ada isinya -->
